            }
          }
        }
      }
    },
    "/api/v1/lab/rules": {
      "get": {
        "summary": "Compare twelve scoring formats under stationary point probabilities",
        "parameters": [
          {
            "name": "pServe",
            "in": "query",
            "required": false,
            "description": "Player 1's serve point win probability.",
            "schema": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 0.95,
              "default": 0.65
            }
          },
          {
            "name": "pReturn",
            "in": "query",
            "required": false,
