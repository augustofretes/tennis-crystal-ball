    "/api/v1/predictions/match": {
      "post": {
        "summary": "Elo baseline from supplied ratings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionInput"
              },
              "example": {
                "player1Elo": 2200,
                "player2Elo": 2000,
                "scale": 400
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Experiment result, inputs, model version and assumptions. Round probabilities count advancing through byes; final round is title probability. Seeded draws average exact probabilities across sampled brackets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Experiment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unknown/repeated query parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulations": {
      "post": {
        "summary": "Bounded synchronous knockout experiment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationInput"
              },
              "example": {
                "players": [
                  {
                    "name": "A",
                    "elo": 2200
                  },
                  {
                    "name": "B",
                    "elo": 2000
                  }
                ],
                "draw": "fixed",
                "iterations": 1,
                "seed": 1973
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Experiment result, inputs, model version and assumptions. Round probabilities count advancing through byes; final round is title probability. Seeded draws average exact probabilities across sampled brackets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Experiment"
                }
              }
            }
          },
          "400": {
