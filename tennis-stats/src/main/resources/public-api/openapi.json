{
  "openapi": "3.0.3",
  "info": {
    "title": "Tennis Crystal Ball Public API",
    "version": "1.0.0",
    "description": "Free men's tennis history and bounded research experiments. No API key required. API schemas are versioned; the underlying corrected data is not an immutable historical snapshot. Coverage dates do not establish completeness. CSV returns one page. Historical data attribution: Jeff Sackmann / Tennis Abstract; current results: ESPN and Tennis Abstract. See repository source notes."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1": {
      "get": {
        "summary": "API directory; no authentication required",
        "responses": {
          "200": {
            "description": "Links to documentation and resources"
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "This OpenAPI specification",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 document"
          }
        }
      }
    },
    "/api/v1/coverage": {
      "get": {
        "summary": "Global data coverage and optional result-ingestion checkpoint",
        "responses": {
          "200": {
            "description": "Coverage envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Coverage"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Metadata"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/players": {
      "get": {
        "summary": "Search players; ordered by stable player ID",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "CSV exports the requested page only.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$"
            }
          },
          {
            "name": "active",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One ordered page. Follow links.next; corrections and ingestion can change pagination between requests.",
            "headers": {
              "Link": {
                "description": "Next page, when available",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "pagination",
                    "links",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Player"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    },
                    "links": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Metadata"
                    }
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unknown/repeated query parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/matches": {
